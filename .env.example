# Base URL used to resolve OG/social preview images. Set to the preview
# deploy's URL when testing; defaults to the production URL otherwise.
NEXT_PUBLIC_SITE_URL=https://docs.plytix.com

# Self-hosted Umami analytics (see comments-1.md).
# Leave unset to disable the tracking script entirely.
NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
